  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "start:dev": "chmod +x ./env.sh && ./env.sh && cp env-config.js ./public/ && env-cmd -f dev.env npm start",
    "build:staging": "env-cmd -f staging.env npm run build",
    "build:production": "env-cmd -f production.env npm run build",
    "storybook": "start-storybook -p 6006 -s public",
    "build-storybook": "build-storybook -s public",
    "deploy:production": "aws s3 sync build/ s3://temp-public-pagopeople-bucket --profile pago-production",
    "deploy:staging": "aws s3 sync build/ s3://pagopeople-staging-public-bucket --profile pago-staging"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "babel-plugin-named-exports-order": "^0.0.2",
    "prop-types": "^15.8.1",
    "webpack": "^5.75.0"
